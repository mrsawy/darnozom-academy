{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["nx-mcp"]
    }
  },
  "contextFileName": "AGENTS.md",
  "autoExecutionPolicy": "always-proceed",
  "toolExecutionPolicy": "always-proceed",
  "commandAllowlist": [
    "git",
    "git *",
    "pnpm",
    "pnpm *",
    "npm",
    "npm *",
    "npx",
    "npx *",
    "node",
    "node *",
    "tsc",
    "tsc *",
    "ls",
    "dir",
    "find",
    "grep",
    "cat",
    "Get-ChildItem*",
    "Get-Content*"
  ]
}
