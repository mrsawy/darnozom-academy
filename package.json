    "@nx/eslint": "^22.4.3",
    "@nx/eslint-plugin": "22.4.3",
    "@nx/js": "22.4.3",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "21.2.2",
    "prettier": "^3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2"
  },
  "nx": {},
  "pnpm": {
