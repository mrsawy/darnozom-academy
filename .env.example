# ═══════════════════════════════════════════════════════════════════════
# LMS Organization – Production Environment Variables
# Copy this file to .env on the EC2 at ~/lms/.env and fill in the values.
# docker-compose.prod.yml loads it via env_file for server + client.
#
# Also set these GitHub Actions secrets (client image build-time):
#   DOCKERHUB_TOKEN, EC2_HOST, EC2_SSH_KEY,
#   NEXT_PUBLIC_API_URL, NEXT_PUBLIC_S3_BUCKET_NAME,
#   NEXT_PUBLIC_S3_REGION, NEXT_PUBLIC_CLOUDFRONT_DOMAIN
# ═══════════════════════════════════════════════════════════════════════

# ── MongoDB Atlas (required – no local mongod is deployed) ───────────
# The server reads MONGODB_URI_PROD when NODE_ENV=production, otherwise MONGODB_URI_DEV.
# Whitelist the EC2 IP in the Atlas network access list before deploying.
MONGODB_URI_PROD=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms
MONGODB_URI_DEV=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms_client

# ── Auth / JWT (required – server validateEnv will refuse to start) ──
JSON_PRIVATE_KEY=                   # Secret key used for JWT signing
REFRESH_TOKEN_SECRET=               # Separate secret for refresh tokens (required)
SESSION_SECRET=                     # Random secret for express-session (OAuth handshake)
OAUTH_SUCCESS_REDIRECT_URL=https://darnozomlms.com/oauth/callback
ACCESS_TOKEN_EXPIRES_IN=15m         # Access token expiry (short-lived)
REFRESH_TOKEN_EXPIRES_IN=7d         # Refresh token expiry (long-lived)
AUTH_EXPIRES_IN=15m                 # Legacy alias for ACCESS_TOKEN_EXPIRES_IN

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.darnozomlms.com/auth/google/callback
# Optional comma-separated allow-list for OAuth post-login redirects
# OAUTH_ALLOWED_REDIRECT_URLS=https://darnozomlms.com/oauth/callback

# ── AWS S3 & CloudFront ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=                 # e.g. us-east-1
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=          # e.g. d1234567890.cloudfront.net (optional)
CLOUDFRONT_DISTRIBUTION_ID= # (optional, for cache invalidation)
# CLOUDFRONT_KEY_PAIR_ID=   # optional – private/signed CloudFront content
# CLOUDFRONT_PRIVATE_KEY=   # optional – PEM with \n for newlines

# ── Client-side public vars (also bake into image via GitHub build-args) ─
NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_REGION=
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=
NEXT_PUBLIC_API_URL=https://api.darnozomlms.com
NEXT_PUBLIC_APP_URL=https://darnozomlms.com
# NEXT_PUBLIC_WS_BASE_URL=https://api.darnozomlms.com   # optional Socket.io base

# ── Application URLs ─────────────────────────────────────────────────
SECURED_BASE_URL=https://api.darnozomlms.com
SECURED_CLIENT_BASE_URL=https://darnozomlms.com
APP_BASE_URL=https://api.darnozomlms.com
# Comma-separated extra hosts for Next.js Server Actions
# SERVER_ACTIONS_ALLOWED_ORIGINS=

# Middleware → same-app fetches inside the client container
INTERNAL_APP_ORIGIN=http://127.0.0.1:3000

# ── Real-time ────────────────────────────────────────────────────────
DISABLE_REALTIME=false
# CORS_ORIGINS=https://darnozomlms.com,https://www.darnozomlms.com

# ── Email (Resend) – used by Nest server + Next contact API ──────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=          # e.g. noreply@yourdomain.com
EMAIL_FROM=info@darnozomlms.com

# ── Paymob ────────────────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_BASEURL=             # e.g. https://accept.paymob.com
PAYMOB_ISLIVE=false
CREDIT_CARD_INTEGRATION_ID= # Card integration numeric ID
WALLET_INTEGRATION_ID=      # Wallet integration numeric ID
S_INTEGRATION=              # Card method name fallback (e.g. creditcard or MIGS-online)
WALLET_METHOD_NAME=         # Wallet method name fallback (e.g. paywallet or UIG-online_new)

# ── Paddle ────────────────────────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_BASE=            # optional, defaults to Paddle production URL

# ── Lemon Squeezy ────────────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
BASIC_LEMON_SQUEEZY_PLAN_ID_MONTHLY=
BASIC_LEMON_SQUEEZY_PLAN_ID_YEARLY=
# LEMON_SQUEEZY_TEST_MODE=false

# ── Kashier ───────────────────────────────────────────────────────────
KASHIER_BASE_URL=
KASHIER_MERCHANT_ACCOUNT_ID=
KASHIER_PAYMENT_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=live           # "test" or "live"

# ── PayPal ────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=            # e.g. https://api-m.paypal.com

# ── AI / OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Transcription ────────────────────────────────────────────────────
GROQ_API_KEY=
TRANSCRIPTION_YT_AUDIO_FALLBACK=false

# ── Currency ──────────────────────────────────────────────────────────
EXCHANGE_RATES_URL=

# ── Agora (RTC video calling + Chat) ─────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_KEY=
AGORA_REST_SECRET=
AGORA_CHAT_APP_KEY=
AGORA_CHAT_ORG_NAME=
AGORA_CHAT_APP_NAME=
AGORA_CHAT_REST_URL=
AGORA_CHAT_WS_URL=
