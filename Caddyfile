# LMS Organization – Caddy reverse proxy
# Domain: safeerlms.com
# Caddy obtains and renews TLS certificates from Let's Encrypt automatically.

# ── Client (Next.js) ─────────────────────────────────────────────────
safeerlms.com, www.safeerlms.com {
	reverse_proxy client:3000
}

# ── API (NestJS) ─────────────────────────────────────────────────────
api.safeerlms.com {
	reverse_proxy server:3000
}
