{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"],
      "@lms-organization/shared-types": ["../../lib/shared-types/src/index.ts"],
      "@lms-organization/shared-types/dto": ["../../lib/shared-types/src/lib/dto/index.ts"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": false,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority",
    "excludeDirectories": ["node_modules", "dist", "build", "coverage", "tmp", "temp"]
  }
}
