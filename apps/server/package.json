{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec nest build",
    "start": "pnpm exec nest start",
    "start:dev": "pnpm exec nest start --watch",
    "dev": "pnpm exec nest start --watch",
    "start:debug": "pnpm exec nest start --debug --watch",
    "start:prod": "node dist/apps/server/src/main.js",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:format": "pnpm format && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "pnpm exec tsx -r tsconfig-paths/register src/database/seeds/seed.ts",
    "seed:dev": "pnpm seed && pnpm start:dev",
    "seed:prod": "pnpm exec tsx -r tsconfig-paths/register src/database/seeds/seed.prod.ts",
    "seed:prod:fresh": "pnpm exec tsx -r tsconfig-paths/register src/database/seeds/seed.prod.ts --fresh",
    "migrate:approve-orgs": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/approve-existing-organizations.ts",
    "migrate:org-onboarding": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/set-organization-onboarded-existing-super-admins.ts",
    "migrate:seed-grades": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/seed-grades.ts",
    "migrate:private-session-instants": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/migrate-private-session-instants.ts",
    "migrate:private-session-soft-delete": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/migrate-private-session-soft-delete.ts",
    "migrate:course-school-type-ids": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/migrate-course-school-type-ids.ts",
    "migrate:user-unique-if-not-deleted": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/migrate-user-unique-if-not-deleted.ts",
    "migrate:enrollment-unique-if-not-deleted": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/migrate-enrollment-unique-if-not-deleted.ts",
    "migrate:grade-schooltype-unique-if-not-deleted": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/migrate-grade-schooltype-unique-if-not-deleted.ts",
    "migrate:all": "pnpm exec tsx -r tsconfig-paths/register src/database/migrations/run-all-migrations.ts",
    "tsc": "tsc"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.52",
    "@aws-sdk/client-cloudfront": "3.879.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/cloudfront-signer": "^3.1005.0",
    "@aws-sdk/lib-storage": "^3.850.0",
    "@casl/ability": "^6.7.3",
    "@fastify/multipart": "^9.0.3",
    "@darnozom/shared-types": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.5",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/websockets": "^11.1.17",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/validator": "^13.15.2",
    "agora-token": "^2.0.5",
    "ai": "6.0.158",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "base-x": "^5.0.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "bullmq": "^5.74.1",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "express-session": "^1.19.0",
    "fastify": "^5.4.0",
    "ffmpeg": "^0.0.4",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^171.4.0",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.33",
    "luxon": "3.7.2",
    "mammoth": "^1.12.0",
    "mongoose": "^8.16.3",
    "mongoose-paginate-v2": "^1.9.1",
    "nats": "^2.29.3",
    "officeparser": "^4.2.0",
    "openai": "^6.34.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.3",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stream": "^0.0.3",
    "uuid": "^11.1.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/luxon": "3.7.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-redos-detector": "^3.1.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "modulePaths": [
      "<rootDir>"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts",
      "<rootDir>/__test__/**/*.(spec|test).ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^@darnozom/shared-types/dto$": "<rootDir>/../../lib/shared-types/src/lib/dto/index.ts",
      "^@darnozom/shared-types$": "<rootDir>/../../lib/shared-types/src/index.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
